<Window x:Class="MusicOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicOverlay"
        Width="350"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0FA3E0"/>

        <!-- простые прозрачные кнопки-глифы с анимацией наведения -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootG" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootG"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.14" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RootG"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.14" Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootG"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RootG"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- переключатель -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Width="40" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="#3A3A3E"/>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- тёмный слайдер -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Border x:Name="TrackBg" Height="5" CornerRadius="2.5" Background="#4A4A4E"
                                    VerticalAlignment="Center" Margin="7,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="13" Height="13" Fill="White" Margin="0,-6,0,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBg" Property="Background" Value="#5A5A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2F"/>
            <Setter Property="BorderBrush" Value="#4B4B52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Pill" CornerRadius="14" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter x:Name="ContentSite" Margin="10,5,30,5" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBlock Text="⌄" Foreground="White" FontSize="14" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   PopupAnimation="Fade">
                                <Border Width="220" MaxHeight="280"
                                        Background="#1D1D22" BorderBrush="#46464E" BorderThickness="1"
                                        CornerRadius="14" Padding="4">
                                    <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#777780"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#332FA3E0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#332FA3E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- строка настройки -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- чип вкладки с анимацией наведения -->
        <Style x:Key="TabChip" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#B9B9BE"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="13" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.06" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.06" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- плитка действия с анимацией наведения -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3AFFFFFF"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bg"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            Background="#F2121216"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            CornerRadius="30"
            MouseLeftButtonUp="OnIslandClick">

        <Grid x:Name="RootLayout">
            <!-- размытая подложка: снимок экрана под виджетом, размытый с эффектом «воды» -->
            <Border x:Name="BackdropHost" Visibility="Collapsed" CornerRadius="30">
                <Image x:Name="BackdropImage" Stretch="Fill" Margin="-12">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="BackdropShift"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <BlurEffect x:Name="BackdropBlur" Radius="18"/>
                    </Image.Effect>
                </Image>
            </Border>

            <!-- тонировка поверх стекла -->
            <Border x:Name="TintBorder" CornerRadius="30"/>

            <Grid x:Name="ContentGrid" Margin="9,9,8,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- шапка: обложка, название, индикаторы, кнопки -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CoverBorder" Width="42" Height="42" CornerRadius="21"
                            Background="#1FFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                            VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="CoverPlaceholder" Text="&#9835;" FontSize="20"
                                       Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Загрузка..." FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Text="" FontSize="12.5" Foreground="#9A9A9E"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <StackPanel x:Name="DotsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <StackPanel x:Name="SmallBarsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"
                                    Visibility="Collapsed" Margin="2,0,0,0"/>

                        <Button x:Name="GearButton" Width="24" Height="24" Margin="6,0,0,0"
                                Style="{StaticResource PlainButton}" Click="Settings_Click" ToolTip="Настройки">
                            <TextBlock Text="&#9881;" FontFamily="Segoe UI Symbol" FontSize="15"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button x:Name="ModeButton" Width="24" Height="24" Margin="2,0,0,0"
                                Style="{StaticResource PlainButton}" Click="Mode_Click" ToolTip="Развернуть">
                            <Grid Width="10" Height="10">
                                <Path x:Name="ExpandGlyph" Data="M1,2 L5,6 L9,2"
                                      Stroke="White" StrokeThickness="1.5" Stretch="Uniform"/>
                                <Path x:Name="CollapseGlyph" Data="M1,6 L5,2 L9,2"
                                      Stroke="White" StrokeThickness="1.5" Stretch="Uniform"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <Button x:Name="CloseButton" Width="24" Height="24" Margin="2,0,0,0"
                                Style="{StaticResource PlainButton}" Click="Close_Click" ToolTip="Закрыть">
                            <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="White" StrokeThickness="1.5"
                                  Stretch="Uniform" Width="9" Height="9"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- вкладки расширенного вида -->
                <ScrollViewer x:Name="TabStrip" Grid.Row="1" Margin="0,10,0,0"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- панели модулей -->
                <Grid x:Name="PanelsHost" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Музыка -->
                    <Grid x:Name="PanelMusic" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" x:Name="ProgressRow" Margin="0,0,0,0"
                              MouseLeftButtonDown="Slider_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText" Text="0:00" FontSize="12" Foreground="#9A9A9E"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Grid x:Name="SliderTrack" Grid.Column="1" Height="14" VerticalAlignment="Center">
                                <Border Height="5" CornerRadius="2.5" Background="#4A4A4E" VerticalAlignment="Center"/>
                                <Border x:Name="ProgressFill" Height="5" CornerRadius="2.5"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left" Width="0" VerticalAlignment="Center"/>
                                <Ellipse x:Name="Thumb" Width="11" Height="11" Fill="White"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="RemainText" Grid.Column="2" Text="-0:00" FontSize="12"
                                       Foreground="#9A9A9E" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>

                        <StackPanel x:Name="TransportRow" Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,14,0,0" Opacity="0.95">
                            <Button x:Name="PrevButton" Width="46" Height="38"
                                    Style="{StaticResource PlainButton}" Click="Prev_Click">
                                <Path Data="M11,3 L1,10 L11,17 Z M22.5,3 L12.5,10 L22.5,17 Z"
                                      Fill="White" Stretch="Uniform" Width="23" Height="18"/>
                            </Button>
                            <Button x:Name="PlayButton" Width="56" Height="42"
                                    Style="{StaticResource PlainButton}" Click="Play_Click">
                                <Grid Width="26" Height="24">
                                    <Path x:Name="PlayGlyph" Data="M4,2 L22,12 L4,22 Z"
                                          Fill="White" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="PauseGlyph" Data="M4,2 H10 V22 H4 Z M15,2 H21 V22 H15 Z"
                                          Fill="White" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="NextButton" Width="46" Height="38"
                                    Style="{StaticResource PlainButton}" Click="Next_Click">
                                <Path Data="M0,3 L10,10 L0,17 Z M11.5,3 L21.5,10 L11.5,17 Z"
                                      Fill="White" Stretch="Uniform" Width="23" Height="18"/>
                            </Button>
                        </StackPanel>

                        <!-- громкость + источник -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#128266;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource DarkSlider}"
                                    Minimum="0" Maximum="100" ValueChanged="VolumeSlider_Changed"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="50%" FontSize="11.5"
                                       Foreground="#9A9A9E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="SourcesText" Grid.Row="3" Text="" FontSize="11" Foreground="#7A7A80"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

                        <!-- история треков -->
                        <ScrollViewer Grid.Row="4" MaxHeight="132" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                                      x:Name="TrackHistoryScroll">
                            <StackPanel x:Name="TrackHistoryPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Система -->
                    <Grid x:Name="PanelSystem" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel x:Name="StatsPanel"/>
                            <!-- график CPU -->
                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,4,0,0">
                                <Grid x:Name="SparkHost" Height="54">
                                    <Polyline x:Name="SparkLine" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.6" Fill="Transparent"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Уведомления -->
                    <Grid x:Name="PanelNotify" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Не беспокоить" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NotifyCountText" Text="" FontSize="11" Foreground="#7A7A80"
                                           VerticalAlignment="Center" Margin="8,1,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="DndToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="230" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NotifyListPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Звук -->
                    <Grid x:Name="PanelAudio" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="DeviceText" Text="Устройство воспроизведения" FontSize="11.5"
                                       Foreground="#7A7A80" TextTrimming="CharacterEllipsis"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#128266;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Style="{StaticResource DarkSlider}"
                                        Minimum="0" Maximum="100" ValueChanged="MasterVolume_Changed"/>
                                <TextBlock x:Name="MasterVolumeText" Grid.Column="2" Text="100%" FontSize="11.5"
                                           Foreground="#9A9A9E" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <Button x:Name="MuteButton" Grid.Column="3" Width="30" Height="30"
                                        Style="{StaticResource PlainButton}" Click="Mute_Click" ToolTip="Выключить звук">
                                    <TextBlock x:Name="MuteGlyph" Text="&#128266;" FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" MaxHeight="250" Margin="0,10,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SessionsPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Буфер обмена -->
                    <Grid x:Name="PanelClipboard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipboardSearch" Background="#16FFFFFF" Foreground="White"
                                     CaretBrush="White" BorderThickness="0" Padding="8,6" FontSize="12.5"
                                     VerticalContentAlignment="Center" TextChanged="ClipboardSearch_Changed"/>
                            <Button Grid.Column="1" Content="Очистить" Margin="6,0,0,0" Padding="8,4"
                                    FontSize="11.5" Foreground="#B9B9BE" Background="#16FFFFFF"
                                    BorderThickness="0" Cursor="Hand" Click="ClipboardClear_Click"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="230" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ClipboardListPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Действия -->
                    <Grid x:Name="PanelActions" Visibility="Collapsed">
                        <WrapPanel x:Name="ActionsPanel" Orientation="Horizontal"/>
                    </Grid>

                    <!-- Погода и часы -->
                    <Grid x:Name="PanelWeather" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="WeatherTime" Text="--:--" FontSize="30" FontWeight="SemiBold"
                                               Foreground="White" LineHeight="34"/>
                                    <TextBlock x:Name="WeatherDate" Text="" FontSize="12.5" Foreground="#9A9A9E"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="WeatherTemp" Text="—" FontSize="22" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="WeatherCity" Text="" FontSize="11" Foreground="#7A7A80"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="ForecastPanel" Margin="0,10,0,0"/>

                            <!-- таймер -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#9200;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TimerText" Grid.Column="1" Text="05:00" FontSize="17"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"
                                           FontFamily="Consolas"/>
                                <Button x:Name="TimerToggleBtn" Grid.Column="2" Content="Старт" Padding="12,5"
                                        Margin="8,0,6,0" FontSize="12" Foreground="White"
                                        Background="#22FFFFFF" BorderThickness="0" Cursor="Hand"
                                        Click="TimerToggle_Click"/>
                                <Button Grid.Column="3" Content="Сброс" Padding="12,5" FontSize="12"
                                        Foreground="#B9B9BE" Background="#16FFFFFF" BorderThickness="0"
                                        Cursor="Hand" Click="TimerReset_Click"/>
                            </Grid>

                            <!-- секундомер -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#9201;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StopwatchText" Grid.Column="1" Text="00:00.0" FontSize="17"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"
                                           FontFamily="Consolas"/>
                                <Button x:Name="StopwatchBtn" Grid.Column="2" Content="Старт" Padding="12,5"
                                        FontSize="12" Foreground="White" Background="#22FFFFFF"
                                        BorderThickness="0" Cursor="Hand" Click="Stopwatch_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Игры -->
                    <Grid x:Name="PanelGaming" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="GamingStatus" Text="Игра не обнаружена" FontSize="15"
                                               FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GamingTimer" Text="Сессия: 00:00" FontSize="12.5"
                                               Foreground="#9A9A9E" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="54" Height="54" CornerRadius="27"
                                        Background="#16FFFFFF" VerticalAlignment="Center">
                                    <Path x:Name="GamingIcon" Data="M3,6 H19 A4,4 0 0 1 23,10 L22,15 A3,3 0 0 1 18,16.5 L16,14 H8 L6,16.5 A3,3 0 0 1 2,15 L1,10 A4,4 0 0 1 3,6 Z M7,9 V12 M5.5,10.5 H8.5 M16,10 H16.01 M18,12 H18.01"
                                              Stroke="#9A9A9E" StrokeThickness="1.6" Fill="Transparent"
                                              Stretch="Uniform" Width="26" Height="26"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Уведомления «Не беспокоить» при игре" FontSize="13"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <CheckBox x:Name="GamingDndToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                            </Grid>
                            <TextBlock x:Name="GamingStats" Text="" FontSize="12" Foreground="#7A7A80"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Лаунчер -->
                    <Grid x:Name="PanelLauncher" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="LauncherSearch" Grid.Row="0" Background="#16FFFFFF" Foreground="White"
                                 CaretBrush="White" BorderThickness="0" Padding="8,6" FontSize="12.5"
                                 VerticalContentAlignment="Center" TextChanged="LauncherSearch_Changed"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="260" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="LauncherList" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- запущенные приложения -->
                <WrapPanel x:Name="AppsRow" Grid.Row="3" Orientation="Horizontal"
                           Margin="0,12,0,0" Visibility="Collapsed"/>

                <!-- настройки -->
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="4" Margin="0,6,0,0"
                              Visibility="Collapsed" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanelContent"/>
                </ScrollViewer>
            </Grid>

            <!-- всплывающее уведомление поверх содержимого -->
            <Border x:Name="Banner" Visibility="Collapsed"
                    Background="#F526262A" CornerRadius="30">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BannerShift" X="-30"/>
                </Border.RenderTransform>
                <StackPanel Margin="16,8" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerApp" Text="" FontSize="11" Foreground="#8CFFFFFF"/>
                    <TextBlock x:Name="BannerText" Text="" FontSize="13" Foreground="White"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- слой пузырьков от кликов -->
            <Canvas x:Name="EffectsLayer" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
